{
  "permissions": {
    "allow": [
      "Bash(git status)", "Bash(git diff:*)", "Bash(git checkout -b:*)",
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git push -u origin ARC-*)",
      "Bash(gh pr create:*)", "Bash(gh pr view:*)"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git push origin main)",
      "Bash(git push origin HEAD:main)", "Bash(gh pr merge:*)", "Bash(gh repo delete:*)",
      "Read(./.env)", "Read(./.env.*)", "Read(./.dev.vars*)",
      "mcp__atlassian__executeDestructive"
    ]
  },
  "extraKnownMarketplaces": {
    "arclab": { "source": { "source": "github", "repo": "CriticalArccx/arclab-claude-workflow" } }
  },
  "enabledPlugins": { "arclab-workflow@arclab": true }
}
